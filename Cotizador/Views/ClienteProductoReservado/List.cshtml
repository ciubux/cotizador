@{
    ViewBag.Title = "Stock Reservado Clientes";
    Model.ClienteProductoReservado search = ViewBag.search;
    string tipoPuntual = "PUNTUAL";
    string tipoPermanente = "PERMANENTE";
}

<div class="page-header">
    <h3>@ViewBag.Title</h3>
</div>

<div class="container">
    <input type="hidden" id="idClienteProductoReservado" value="" />

    <form class="form-horizontal">
        <div class="row">
            <div class="col-sm-6 col-lg-4">
                <div class="form-group row">
                    <label class="control-label col-xs-4">Ciudad:</label>
                    <div class="col-xs-8">
                        @Html.Action("GetCiudades", "Ciudad", new { ciudadSelectId = "idCiudadBusqueda", selectedValue = search.ciudad.idCiudad })
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="form-group row">
                    <label class="control-label col-xs-4">Cliente:</label>
                    <div class="col-xs-8">
                        <select class="form-control input-sm" id="idClienteBusqueda" name="idClienteBusqueda" required>
                            @if (search.cliente != null && !search.cliente.idCliente.Equals(Guid.Empty))
                            {
                                <option value="@search.cliente.idCliente">@search.cliente.ToString()</option>
                            }
                            else
                            {
                                <option value=""></option>

                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="form-group row">
                    <label class="control-label col-xs-4">Tipo:</label>
                    <div class="col-xs-8">
                        <select id="tipoReserva" class="form-control">
                            <option value="TODOS" @(search.tipo.Equals("TODOS") ? "selected" : "")>TODOS</option>
                            <option value="@tipoPermanente" @(search.tipo.Equals(tipoPermanente) ? "selected" : "")>@tipoPermanente</option>
                            <option value="@tipoPuntual" @(search.tipo.Equals(tipoPuntual) ? "selected" : "")>@tipoPuntual</option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <label class="control-label col-xs-4">Estado:</label>
                    <div class="col-xs-8">
                        <select id="estadoBusqueda" class="form-control">
                            <option value="1" @(search.Estado == 1 ? "selected" : "")>Activo</option>
                            <option value="0" @(search.Estado == 0 ? "selected" : "")>Inactivo</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" style="margin-top: 10px;">
            <div class="col-sm-6 col-lg-4">
                <div class="form-group">
                    <label class="control-label col-xs-4" for="skuProducto">SKU:</label>
                    <div class="col-xs-8">
                        <input class="form-control" type="text" id="skuProducto" name="skuProducto" value="@search.producto.sku">
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <!--Proveedor-->
                <div class="form-group">
                    <label class="control-label col-xs-4" for="proveedor">Proveedor:</label>
                    <div class="col-xs-8">
                        <div>
                            @Html.Action("list", "Proveedor")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="form-group">
                    <label class="control-label col-xs-4" for="tieneSolicitudStock">Solicitud Recarga Stock:</label>
                    <div class="col-xs-8">
                        <select class="form-control" id="tieneSolicitudStock" name="tieneSolicitudStock">
                            <option @(search.filtroTieneSolicitudRecargaActiva == -1 ? "selected" : "") value="-1">-</option>
                            <option @(search.filtroTieneSolicitudRecargaActiva == 0 ? "selected" : "") value="0">No Tiene Solcitud</option>
                            <option @(search.filtroTieneSolicitudRecargaActiva == 1 ? "selected" : "") value="1">Tiene Solicitud</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6 col-lg-4">
                <div class="form-group row">
                    <label class="control-label col-xs-4" for="tipoUnidad">Unidad:</label>
                    <div class="col-xs-8">
                        <select class="form-control" id="tipoUnidad" name="tipoUnidad">
                            <option @(search.idPresentacionUnidad == 0 ? "selected" : "") value="0">MP</option>
                            <option @(search.idPresentacionUnidad == 1 ? "selected" : "") value="1">Alternativa</option>
                            <option @(search.idPresentacionUnidad == 2 ? "selected" : "") value="2">Proveedor</option>
                            <option @(search.idPresentacionUnidad == 3 ? "selected" : "") value="3">Conteo</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row pull-right" style="margin-bottom:10px; margin-right:0px">
            <button id="btnLimpiarBusqueda" type="button" class="btn btn-primary bouton-image botonClean">Limpiar</button>
            <button id="btnBusqueda" type="button" class="btn btn-primary bouton-image botonSearch">Buscar</button>
        </div>

        <div id="divExportButton" class="row pull-left" style="margin-bottom:10px; margin-left:0px;">
            <button id="btnAbrirModalCargaMasiva" type="button" class="btn btn-warning">Carga Masiva</button>
            <button id="btnAgregar" type="button" class="btn btn-primary">Registrar Nuevo</button>
            <button id="btnExportExcel" type="button" class="btn btn-primary bouton-image botonExcel">Exportar Resultados</button>
            <button id="btnMostrarStocks" type="button" class="btn btn-info">Mostrar Stocks</button>
        </div>

        <table id="tableRegistros" class="table" data-paging="true" data-sorting="true">
            <thead>
                <tr>
                    <th data-name="idClienteProductoReservado" data-visible="false"></th>
                    <th data-name="ciudad">Ciudad</th>
                    <th data-name="tipo">Tipo</th>
                    <th data-name="cliente">Cliente</th>
                    <th data-name="producto">Producto</th>
                    <th data-name="unidad">Unidad</th>
                    <th data-name="cantidadOriginal">Reserva Base</th>
                    <th data-name="cantidadReserva">Reserva Activa</th>
                    <th data-name="cantidadAtendida">Atendida</th>
                    <th data-name="stock">Stock Real</th>
                    <th data-name="stockDisponible">Stock Disponible</th>
                    <th data-name="stockVirtual">Stock Virtual</th>
                    <th data-name="opciones" data-breakpoints="xs"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </form>
</div>


<div class="modal fade" id="modalEditarClienteProductoReservado" tabindex="-1">
    <div class="modal-dialog modal-lg" style="width: 650px;">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="modalEditarClienteProductoReservadoTitle"></h4>
            </div>
            <div class="modal-body">
                <form class="form-horizontal">
                    <input type="hidden" id="modal_id" value="" />
                    <input type="hidden" id="modal_divisor" value="1" /> <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-xs-4">Ciudad:</label>
                                <div class="col-xs-8">
                                    @Html.Action("GetCiudades", "Ciudad", new { ciudadSelectId = "modal_idCiudad" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-xs-4">Cliente:</label>
                                <div class="col-xs-8">
                                    <select class="form-control input-sm" id="modal_idCliente" name="modal_idCliente" required>
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-xs-4">Producto:</label>
                                <div class="col-xs-8">
                                    <select class="form-control" id="modal_idProducto" name="producto">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-xs-4">Unidad:</label>
                                <div class="col-xs-8">
                                    <p id="modal_unidadConteo" class="form-control-static"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-xs-4">Tipo:</label>
                                <div class="col-xs-8">
                                    <select class="form-control input-sm" id="modal_tipo" name="modal_tipo" required>
                                        <option value=""></option>
                                        <option value="@tipoPermanente">@tipoPermanente</option>
                                        <option value="@tipoPuntual">@tipoPuntual</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-xs-4">Reserva Base:</label>
                                <div class="col-xs-8">
                                    <input type="number" id="modal_cantidadOriginal" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" id="btnFinalizarEdicion" class="btn btn-primary"></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCargaMasivaClienteProductoReservado" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Carga Masiva de Reservas en la sede de <span id="modalCPRCiudadtitulo"></span></h4>
            </div>

            <div class="modal-body">
                <form class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12 col-lg-12">
                            <div class="form-group">
                                <label class="control-label col-xs-3">Archivo:</label>
                                <div class="col-xs-9">
                                    <input id="modalCPRExcelFile" name="file" type="file"
                                           class="btn btn-primary" data-max-size="2097152" data-max-size-text="2MB"
                                           accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-sm-12 col-lg-12">
                            <p>
                                <b>CONSIDERACIONES</b>
                                <ul>
                                    <li>El formato del archivo debe ser el mismo que la descarga de exportación.</li>
                                    <li>Si la <b>Reserva Base</b> es 0, la reserva se eliminará (desactivará).</li>
                                    <li>Si la reserva ya existe, se actualizará.</li>
                                    <li>Asegúrese de seleccionar la Sede correcta en los filtros antes de cargar.</li>
                                </ul>
                            </p>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" id="btnModalCargaMasivaCPRAceptar" class="btn btn-primary">Procesar Excel</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalAgregarReserva" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Agregar a Cantidad de Reserva</h4>
            </div>
            <div class="modal-body">
                <form class="form-horizontal">
                    <input type="hidden" id="modal_res_id" />
                    <input type="hidden" id="modal_res_divisor" value="1" /> <div class="form-group">
                        <label class="control-label col-xs-4">Sede:</label>
                        <div class="col-xs-8">
                            <input type="text" id="modal_res_sede" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-xs-4">Cliente:</label>
                        <div class="col-xs-8">
                            <input type="text" id="modal_res_cliente" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-xs-4">Producto (SKU):</label>
                        <div class="col-xs-8">
                            <input type="text" id="modal_res_sku" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="form-group" style="margin-bottom: 5px;">
                        <div class="col-xs-4"></div>
                        <div class="col-xs-4 text-center"><b>Unid. Selec.</b></div>
                        <div class="col-xs-4 text-center"><b>Unid. Conteo</b></div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-xs-4">Unidad:</label>
                        <div class="col-xs-4">
                            <select id="modal_res_tipoUnidad" class="form-control"></select>
                        </div>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_unidad_conteo" class="form-control text-center" readonly />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-xs-4 text-info">Stock Real:</label>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_stock_real_selec" class="form-control text-info" readonly />
                        </div>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_stock_real_base" class="form-control text-info" readonly />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-xs-4 text-info">Stock Disponible:</label>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_stock_disp_selec" class="form-control text-info" style="margin-bottom: 5px;" readonly />
                            <a class="modal_res_stock_pend_recep_select verModalStockPendienteRecepcion" idproducto="" idproductopresentacion="" idciudad="" fechainicio="" fechafin="" style="cursor:pointer;" title="Pendiente por Recepcionar">
                                <span class="label label-stock-plus">+0</span>
                            </a>
                            <a class="modal_res_stock_pend_aten_select verModalStockPendienteAtencion" idproducto="" idproductopresentacion="" idciudad="" fechainicio="" fechafin="" style="cursor:pointer;" title="Pendiente por Atender">
                                <span class="label label-stock-less" style="margin-left: 1px;">-0</span>
                            </a>
                        </div>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_stock_disp_base" class="form-control text-info" style="margin-bottom: 5px;" readonly />
                            <a class="modal_res_stock_pend_recep_base verModalStockPendienteRecepcion" idproducto="" idproductopresentacion="" idciudad="" fechainicio="" fechafin="" style="cursor:pointer;" title="Pendiente por Recepcionar">
                                <span class="label label-stock-plus">+0</span>
                            </a>
                            <a class="modal_res_stock_pend_aten_base verModalStockPendienteAtencion" idproducto="" idproductopresentacion="" idciudad="" fechainicio="" fechafin="" style="cursor:pointer;" title="Pendiente por Atender">
                                <span class="label label-stock-less" style="margin-left: 1px;">-0</span>
                            </a>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-xs-4 text-info">Stock Virtual:</label>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_stock_virt_selec" class="form-control text-info" readonly />
                        </div>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_stock_virt_base" class="form-control text-info" readonly />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-xs-4">Reserva Base:</label>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_cant_original_selec" class="form-control" readonly />
                        </div>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_cant_original_base" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-xs-4">Reserva Activa:</label>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_cant_actual_selec" class="form-control" readonly />
                        </div>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_cant_actual_base" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="form-group" id="divSolicitudReservaActivaModal" style="display:none;">
                        <label class="control-label col-xs-4 text-warning">Solicitado:</label>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_cant_solicitada_selec" class="form-control" readonly />
                        </div>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_cant_solicitada_base" class="form-control" readonly />
                        </div>
                    </div>

                    <hr />

                    <div class="form-group">
                        <label class="control-label col-xs-4 text-primary"><b>Agregar a Reserva:</b></label>
                        <div class="col-xs-4">
                            <input type="number" id="modal_res_cant_agregar_selec" class="form-control border-primary" value="0" step="1" />
                        </div>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_cant_agregar_base" class="form-control" readonly value="0" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label col-xs-4 text-success"><b>Nueva Cantidad Reserva:</b></label>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_cant_resultante_selec" class="form-control font-weight-bold text-success" readonly />
                        </div>
                        <div class="col-xs-4">
                            <input type="text" id="modal_res_cant_resultante_base" class="form-control font-weight-bold text-success" readonly />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardarReserva" class="btn btn-primary">Aceptar</button>
            </div>
        </div>
    </div>
</div>


@Html.Partial("../Stock/_ModalStockProducto")

@Html.Partial("../Stock/_ModalStockPendienteAtencion")

@Html.Partial("../Stock/_ModalStockPendienteRecepcion")

@Html.Partial("../Pedido/_ModalPedidoReadOnly")


@Html.Partial("../ClienteProductoReservado/_ModalHistorialMovimientos")

<style>
    #modal_idProducto_chosen {
        width: 100% !important;
    }

    #modal_idCliente_chosen {
        width: 100% !important;
    }

    input.form-control.text-danger {
        color: #a94442 !important;
    }

    input.form-control.text-success {
        color: #3c763d !important;
    }
</style>

@section Scripts {
    @Scripts.RenderFormat("<script type=\"text/javascript\" src=\"{0}?nocache=" + TempData["ScriptVersion"] + "\"></script>", "~/bundles/clienteProductoReservado")
}