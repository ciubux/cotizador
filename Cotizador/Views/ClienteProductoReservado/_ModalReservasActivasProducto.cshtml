
<div class="modal fade" tabindex="-1" id="modalReservasActivasProducto">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="modalReservasActivasTitle"><b>Reservas Activas por Producto</b></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <form class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-6 col-lg-8">
                            <div class="form-group">
                                <label class="control-label col-xs-2">Producto:</label>
                                <div class="col-xs-10">
                                    <span class="form-control-static" id="verNombreProductoReservasActivas"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <div class="form-group">
                                <label class="control-label col-xs-4">SKU:</label>
                                <div class="col-xs-8">
                                    <p class="form-control-static" id="verSkuProductoReservasActivas"></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-8">
                            <div class="form-group">
                                <label class="control-label col-xs-2">Unidad:</label>
                                <div class="col-xs-10">
                                    <select id="selectUnidadProductoReservasActivas" class="form-control">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <div class="form-group">
                                <label class="control-label col-xs-4">Sede:</label>
                                <div class="col-xs-8">
                                    <p class="form-control-static" id="verSedeReservasActivas"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="row mt-3">
                    <div class="col-sm-12 col-lg-12 tableFixHead modalDivResultsTable">
                        <table id="tableReservasActivasProducto" class="table table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Sede</th>
                                    <th>Cliente</th>
                                    <th>Reserva Base</th>
                                    <th>Reserva Activa</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">

function funcionesModalReservasActivasProducto() {
    var idCiudad = '';
    var idProducto = '';
    var idPedido = '';
    var idProductoPresentacion = 0;

    $(document).on('click', ".verModalReservasActivasProducto", function (e) {
        e.preventDefault();

        idProducto = $(this).attr("idProducto");
        idPedido = $(this).attr("idpedido"); 
        idCiudad = $(this).attr("idCiudad");
        idProductoPresentacion = $(this).attr("idProductoPresentacion") || 0;

        cargarReservasActivas();
    });

    $(document).on('change', "#selectUnidadProductoReservasActivas", function () {
        var idPresentacion = $(this).val();
        idProductoPresentacion = idPresentacion;

        $("td.tdReservaBase").each(function () {
            if (idPresentacion == 0) { $(this).html($(this).attr("cMP")); }
            if (idPresentacion == 1) { $(this).html($(this).attr("cAlternativa")); }
            if (idPresentacion == 2) { $(this).html($(this).attr("cProveedor")); }
        });

        $("td.tdReservaActiva").each(function () {
            if (idPresentacion == 0) { $(this).html($(this).attr("cMP")); }
            if (idPresentacion == 1) { $(this).html($(this).attr("cAlternativa")); }
            if (idPresentacion == 2) { $(this).html($(this).attr("cProveedor")); }
        });
    });


    function cargarReservasActivas() {
        $('body').loadingModal({ text: 'Cargando Reservas...' });
        $('body').loadingModal('show');

        $.ajax({
            url: "/ClienteProductoReservado/ListForProducto", 
            type: 'POST',
            dataType: 'JSON',
            data: {
                idProducto: idProducto,
                idpedido: idPedido, 
                idCiudad: idCiudad,
                idPresentacion: idProductoPresentacion
            },
            error: function () {
                $('body').loadingModal('hide');
                alert("Ocurrió un error al cargar los datos.");
            },
            success: function (result) {
                var producto = result.producto;
                var ciudad = result.ciudad;
                var lista = result.lista;

                var htmlOptionsUnidad = "";
                var unidadSelected = "";

                unidadSelected = (idProductoPresentacion == '0') ? "selected" : "";
                htmlOptionsUnidad += '<option value="0" ' + unidadSelected + '>' + producto.unidad + '</option>';

                if (producto.equivalenciaAlternativa > 1) {
                    unidadSelected = (idProductoPresentacion == '1') ? "selected" : "";
                    htmlOptionsUnidad += '<option value="1" ' + unidadSelected + '>' + producto.unidad_alternativa + '</option>';
                }

                if (producto.equivalenciaProveedor > 1) {
                    unidadSelected = (idProductoPresentacion == '2') ? "selected" : "";
                    htmlOptionsUnidad += '<option value="2" ' + unidadSelected + '>' + producto.unidadProveedor + '</option>';
                }

                $("#selectUnidadProductoReservasActivas").html(htmlOptionsUnidad);

                $("#verSedeReservasActivas").html(ciudad.nombre);
                $("#verNombreProductoReservasActivas").html(producto.descripcion);
                $("#verSkuProductoReservasActivas").html(producto.sku);

                var htmlList = "";

                for (var i = 0; i < lista.length; i++) {
                    var item = lista[i];
                    var cantidadBase = parseFloat(item.cantidadOriginal) || 0;
                    var cantidadActiva = parseFloat(item.cantidadReserva) || 0;

                    var eqEstandar = producto.equivalenciaUnidadEstandarUnidadConteo || 1;
                    var eqAlternativa = (eqEstandar / (producto.equivalenciaAlternativa || 1));
                    var eqProveedor = (eqEstandar * (producto.equivalenciaProveedor || 1));

                    var baseMP = (cantidadBase / eqEstandar).toFixed(2);
                    var baseAlternativa = (cantidadBase / eqAlternativa).toFixed(2);
                    var baseProveedor = (cantidadBase / eqProveedor).toFixed(2);

                    var activaMP = (cantidadActiva / eqEstandar).toFixed(2);
                    var activaAlternativa = (cantidadActiva / eqAlternativa).toFixed(2);
                    var activaProveedor = (cantidadActiva / eqProveedor).toFixed(2);

                    var mostrarBase = baseMP;
                    var mostrarActiva = activaMP;

                    if (idProductoPresentacion == 1) {
                        mostrarBase = baseAlternativa;
                        mostrarActiva = activaAlternativa;
                    } else if (idProductoPresentacion == 2) {
                        mostrarBase = baseProveedor;
                        mostrarActiva = activaProveedor;
                    }

                    var textoCliente = item.cliente.codigo + ' - (' + item.cliente.ruc + ') ' + item.cliente.razonSocial;

                    htmlList += '<tr>' +
                        '<td>' + item.ciudad.nombre + '</td>' +
                        '<td>' + textoCliente + '</td>' +
                        '<td class="tdReservaBase" cMP="' + baseMP + '" cAlternativa="' + baseAlternativa + '" cProveedor="' + baseProveedor + '">' + mostrarBase + '</td>' +
                        '<td class="tdReservaActiva" style="color: blue; font-weight: bold;" cMP="' + activaMP + '" cAlternativa="' + activaAlternativa + '" cProveedor="' + activaProveedor + '">' + mostrarActiva + '</td>' +
                        '</tr>';
                }

                $("#tableReservasActivasProducto tbody").html(htmlList);

                $('body').loadingModal('hide');
                $("#modalReservasActivasProducto").modal('show');
            }
        });
    }
}

// Inicialización cruzada de eventos
if (window.addEventListener) {
    window.addEventListener('load', funcionesModalReservasActivasProducto, false);
} else if (window.attachEvent) {
    window.attachEvent('onload', funcionesModalReservasActivasProducto);
}




</script>
