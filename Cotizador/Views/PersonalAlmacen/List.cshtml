@{
    ViewBag.Title = "Personal de Almacén";
    Model.PersonalAlmacen search = ViewBag.personal;
}

<div class="page-header">
    <h3>@ViewBag.Title</h3>
</div>

<div class="container">
    <input type="hidden" id="idPersonalAlmacen" value="" />
    <input type="hidden" id="pagina" value="@ViewBag.pagina" />

    <form class="form-horizontal">
        <div class="row">
            <div class="col-sm-6 col-lg-4">
                <div class="form-group row">
                    <label class="control-label col-xs-4">Sede Principal:</label>
                    <div class="col-xs-8">
                        @Html.Action("GetCiudades", "Ciudad", new { ciudadSelectId = "idSedeBusqueda", selectedValue = search.sedePrincipal.idCiudad })
                    </div>
                </div>
            </div>
        </div>

        <div class="row pull-right" style="margin-bottom:10px; margin-right:0px">
            <button id="btnLimpiarBusqueda" type="button" class="btn btn-primary bouton-image botonClean">Limpiar</button>
            <button id="btnBusqueda" type="button" class="btn btn-primary bouton-image botonSearch">Buscar</button>
        </div>

        <div id="divExportButton" class="row pull-left" style="margin-bottom:10px; margin-left:0px;">
            <button id="btnAgregarPersonal" type="button" class="btn btn-primary">Registrar Nuevo Personal</button>
            <button id="btnExportExcel" type="button" class="btn btn-primary bouton-image botonExcel">Exportar</button>
        </div>

        <table id="tablePersonal" class="table" data-paging="true" data-sorting="true">
            <thead>
                <tr>
                    <th data-name="idPersonalAlmacen" data-visible="false"></th>
                    <th data-name="sede">Sede</th>
                    <th data-name="documento">Nro. Doc</th>
                    <th data-name="nombreCompleto">Apellidos y Nombres</th>
                    <th data-name="tipo">Tipo</th>
                    <th data-name="opciones" data-breakpoints="xs"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </form>
</div>

<div class="modal fade" id="modalEditarPersonal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="modalEditarPersonalTitle"></h4>
            </div>
            <div class="modal-body">
                <form class="form-horizontal">
                    <input type="hidden" id="personal_id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.nombres, new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">@Html.TextBoxFor(g => search.nombres, new { @id = "personal_nombres", @class = "form-control" })</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.nroDocumento, new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">@Html.TextBoxFor(g => search.nroDocumento, new { @id = "personal_documento", @class = "form-control" })</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.apellidoPaterno, new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">@Html.TextBoxFor(g => search.apellidoPaterno, new { @id = "personal_paterno", @class = "form-control" })</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.apellidoMaterno, new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">@Html.TextBoxFor(g => search.apellidoMaterno, new { @id = "personal_materno", @class = "form-control" })</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.tipo, new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">
                                    <select name="personal_tipo" id="personal_tipo" class="form-control">
                                        <option value="CHOFER">CHOFER</option>
                                        <option value="ASISTENTE">ASISTENTE</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-xs-4">Sede:</label>
                                <div class="col-xs-8">
                                    @Html.Action("GetCiudades", "Ciudad", new { ciudadSelectId = "personal_idSede", selectedValue = search.sedePrincipal.idCiudad })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.brevete, new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">@Html.TextBoxFor(g => search.brevete, new { @id = "personal_brevete", @class = "form-control" })</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" id="btnFinalizarEdicionPersonal" class="btn btn-primary"></button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.RenderFormat("<script type=\"text/javascript\" src=\"{0}?nocache=" + TempData["ScriptVersion"] + "\"></script>", "~/bundles/personalAlmacen")
}