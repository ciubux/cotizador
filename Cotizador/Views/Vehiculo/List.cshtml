@{
    ViewBag.Title = "Vehículos";
    // Asumiendo que el namespace del modelo es el mismo, ajusta si es necesario
    Model.Vehiculo search = ViewBag.vehiculo;
}

<div class="page-header">
    <h3>@ViewBag.Title</h3>
</div>

<div class="container">
    <input type="hidden" id="idVehiculo" value="" />
    <input type="hidden" id="pagina" value="@ViewBag.pagina" />

    <form class="form-horizontal">
        <div class="row">
            <div class="col-sm-6 col-lg-4">
                <div class="form-group row">
                    <label class="control-label col-xs-4" for="idCiudad">
                        Sede:
                    </label>
                    <div class="col-xs-8">
                        @Html.Action("GetCiudades", "Ciudad",
                                        new
                                        {
                                            ciudadSelectId = "idCiudad",
                                            selectedValue = search.ciudad.idCiudad
                                        })
                    </div>
                </div>
            </div>
        </div>

        <div class="row pull-right" style="margin-bottom:10px; margin-right:0px">
            <button id="btnLimpiarBusqueda" type="button" class="btn btn-primary bouton-image botonClean">Limpiar</button>
            <button id="btnBusqueda" type="button" class="btn btn-primary bouton-image botonSearch">Buscar</button>
        </div>

        <div id="divExportButton" class="row pull-left" style="margin-bottom:10px; margin-left:0px;">
            <button id="btnAgregarVehiculo" type="button" class="btn btn-primary">Registrar Nuevo Vehículo</button>
            <button id="btnExportExcel" type="button" class="btn btn-primary bouton-image botonExcel">Exportar</button>
        </div>

        <table id="tableVehiculos" class="table" data-editing="false" data-paging="true" data-paging-count-format="{CP} de {TP}"
               data-editing-allow-add="false"
               data-editing-allow-delete="false"
               data-editing-allow-edit="false"
               data-sorting="true"
               data-show-toggle="false"
               data-editing-hide-text="Finalizar edición"
               data-editing-add-text="Descartar cambios">
            <thead>
                <tr>
                    <th data-name="idVehiculo" data-visible="false"></th>
                    <th data-name="ciudad" data-visible="true">Sede</th>
                    <th data-name="placa" data-visible="true" data-sortable="true">Placa</th>
                    <th data-name="marca" data-visible="true" data-sortable="true">Marca</th>
                    <th data-name="modelo" data-visible="true">Modelo</th>
                    <th data-name="opciones" data-sortable="true" data-breakpoints="xs"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </form>
</div>

<div class="modal fade" id="modalEditarVehiculo" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="modalEditarVehiculoTitle"></h4>
            </div>

            <div class="modal-body">
                <form class="form-horizontal">
                    <input type="hidden" id="vehiculo_id" />

                    <div class="row">
                        <div class="col-sm-12 col-lg-12">
                            <div class="form-group">
                                @Html.LabelFor(g => search.placa, htmlAttributes: new { @class = "control-label col-xs-2" })
                                <div class="col-xs-10">
                                    @Html.TextBoxFor(g => search.placa, htmlAttributes: new { @id = "vehiculo_placa", @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-12 col-lg-12">
                            <div class="form-group">
                                @Html.LabelFor(g => search.marca, htmlAttributes: new { @class = "control-label col-xs-2" })
                                <div class="col-xs-10">
                                    @Html.TextBoxFor(g => search.marca, htmlAttributes: new { @id = "vehiculo_marca", @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-12 col-lg-12">
                            <div class="form-group">
                                @Html.LabelFor(g => search.modelo, htmlAttributes: new { @class = "control-label col-xs-2" })
                                <div class="col-xs-10">
                                    @Html.TextBoxFor(g => search.modelo, htmlAttributes: new { @id = "vehiculo_modelo", @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-12 col-lg-12">
                            <div class="form-group">
                                <label class="control-label col-xs-2">Ciudad:</label>
                                <div class="col-xs-10">
                                    @Html.Action("GetCiudades", "Ciudad",
                                    new
                                    {
                                        ciudadSelectId = "vehiculo_idCiudad",
                                        selectedValue = search.ciudad.idCiudad
                                    })
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" id="btnCancelarVehiculo" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" id="btnFinalizarEdicionVehiculo" class="btn btn-primary"></button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.RenderFormat("<script type=\"text/javascript\" src=\"{0}?nocache=" + TempData["ScriptVersion"] + "\"></script>", "~/bundles/vehiculo")
}