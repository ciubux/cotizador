@{
    ViewBag.Title = "Consolidado de Atención";
    Model.ConsolidadoAtencion search = ViewBag.consolidado;
}

<div class="page-header">
    <h3>@ViewBag.Title</h3>
</div>

<div class="container">
    <input type="hidden" id="pagina" value="@ViewBag.pagina" />

    <div class="row">
        <div class="col-sm-6 col-lg-4">
            <div class="form-group">
                @Html.LabelFor(g => search.ciudad, htmlAttributes: new { @class = "control-label col-xs-4" })
                <div class="col-xs-8">
                    @Html.Action("GetCiudades", "Ciudad",
                    new
                    {
                        ciudadSelectId = "search_ciudad",
                        selectedValue = search.ciudad.idCiudad
                    })
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4">
            <div class="form-group">
                @Html.LabelFor(g => search.fecha, htmlAttributes: new { @class = "control-label col-xs-4" })
                <div class="col-xs-8">
                    <input type="text" id="search_fecha" class="form-control" value="@search.fechaDesc" />
                </div>
            </div>
        </div>
    </div>

    <br />
    <div class="row">
        <div class="col-sm-12">
            <div class="row pull-right" style="margin-bottom:10px; margin-right:0px">
                <button id="btnBusqueda" type="button" class="btn btn-primary bouton-image botonSearch">Buscar</button>
            </div>

            <div id="divExportButton" class="row pull-left" style="margin-bottom:10px; margin-left:0px;">
                <button id="btnAgregarConsolidado" type="button" class="btn btn-primary">Nuevo Consolidado</button>
                <button id="btnExportarExcelRutasLista" type="button" class="btn btn-primary bouton-image botonExcel">Descargar Ruta Pedidos</button>
                
            </div>
        </div>
    </div>

    <table id="tableConsolidados" class="table" data-paging="true">
        <thead>
            <tr>
                <th data-name="fecha">Fecha</th>
                <th data-name="vehiculo">Vehículo (Placa)</th>
                <th data-name="chofer">Chofer</th>
                <th data-name="asistente">Asistente</th>
                <th data-name="opciones">Opciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>



<div class="modal fade" id="modalVerConsolidadoAtencion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="modalVerConsolidadoAtencion"><b>Información de Consolidado de Atención</b></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <p></p>
            </div>



            <div class="modal-body">
                <form class="form-horizontal">

                    <input type="hidden" id="ver_idConsolidadoAtencion" />

                    <div class="row">
                        <div class="col-sm-6 col-lg-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.ciudad, htmlAttributes: new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">
                                    <p class="form-control-static" id="ver_ciudad"></p>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.fecha, htmlAttributes: new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">
                                    <p class="form-control-static" id="ver_fecha"></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 col-lg-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.vehiculo, htmlAttributes: new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">
                                    <p class="form-control-static" id="ver_vehiculo"></p>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.chofer, htmlAttributes: new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">
                                    <p class="form-control-static" id="ver_chofer"></p>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6 col-lg-6">
                            <div class="form-group">
                                @Html.LabelFor(g => search.asistente, htmlAttributes: new { @class = "control-label col-xs-4" })
                                <div class="col-xs-8">
                                    <p class="form-control-static" id="ver_asistente"></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-12 col-lg-12">
                            <div class="form-group">
                                @Html.LabelFor(g => search.observaciones, htmlAttributes: new { @class = "control-label col-xs-2" })
                                <div class="col-xs-10">
                                    <p class="form-control-static" id="ver_observaciones"></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xs-12">
                            <table id="tablePedidosConsolidado" class="table" data-editing="false">
                                <thead>
                                    <tr>
                                        <th data-name="idPedido" data-visible="false"></th>
                                        <th data-name="numero" data-sortable="false">Número Pedido</th>
                                        <th data-name="cliente" data-sortable="false" data-visible="true" data-breakpoints="xs sm">Cliente</th>
                                        <th data-name="fechaEntrega" data-sortable="false" data-visible="true" data-breakpoints="xs sm">Fecha Entrega</th>
                                        <th data-name="Estado Stock" data-sortable="false" data-breakpoints="xs">Estado Stock</th>
                                        <th data-name="Observaciones" data-sortable="false">Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <div class="pull-left">
                    <button type="button" id="btnDescargarConsolidado" class="btn btn-primary">Descargar</button>
                </div>

                <div class="pull-right">
                    <button type="button" id="btnCancelarVerGuiaRemision" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    @if (search.usuario.modificaMaestroConsolidadoAtencion)
                    {
                        <button type="button" id="btnEditar" class="btn btn-primary">Editar</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.RenderFormat("<script type=\"text/javascript\" src=\"{0}?nocache=" + TempData["ScriptVersion"] + "\"></script>", "~/bundles/consolidadoAtencion")
}