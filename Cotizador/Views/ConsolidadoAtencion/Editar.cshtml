@{
    ViewBag.Title = "Crear/Modificar Consolidado Atención";
    Model.ConsolidadoAtencion item = ViewBag.item;
}

<div class="page-header">
    <h3>@ViewBag.Title</h3>
</div>

<div class="container">
    <input type="hidden" id="pagina" value="@ViewBag.pagina" />
    <form class="form-horizontal">

        <input type="hidden" id="idConsolidadoAtencion" name="idConsolidadoAtencion" value="@item.idConsolidadoAtencion" />

        <div class="row">
            <div class="col-lg-4 col-xs-6">
                <div class="form-group">
                    <label class="control-label col-xs-4">Sede:</label>
                    <div class="col-xs-8">
                        @Html.Action("GetCiudades", "Ciudad",
                            new
                            {
                                ciudadSelectId = "consolidado_idCiudad",
                                selectedValue = item.ciudad.idCiudad
                            })
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-xs-6">
                <div class="form-group">
                    <label class="control-label col-xs-4">Fecha:</label>
                    <div class="col-xs-8">
                        <input type="text" id="consolidado_fecha" class="form-control" value="@item.fechaDesc" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-4 col-xs-6">
                <div class="form-group">
                    <label class="control-label col-xs-4">Vehículo:</label>
                    <div class="col-xs-8">
                        <select class="form-control" id="consolidado_idVehiculo">
                            <option>Seleccione</option>
                            @foreach (Model.Vehiculo ve in ViewBag.vehiculos)
                            {
                                <option @(item.vehiculo.idVehiculo.Equals(ve.idVehiculo) ? "selected" : "") value="@ve.idVehiculo">@ve.ToString()</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-xs-6">
                <div class="form-group">
                    <label class="control-label col-xs-4">Chofer:</label>
                    <div class="col-xs-8">
                        <select class="form-control" id="consolidado_idChofer">
                            <option>Seleccione</option>
                            @foreach (Model.PersonalAlmacen cho in ViewBag.choferes)
                            {
                                <option @(item.chofer.idPersonalAlmacen.Equals(cho.idPersonalAlmacen) ? "selected" : "") value="@cho.idPersonalAlmacen">@cho.ToString()</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-xs-6">
                <div class="form-group">
                    <label class="control-label col-xs-4">Asistente:</label>
                    <div class="col-xs-8">
                        <select class="form-control" id="consolidado_idAsistente">
                            <option>Seleccione</option>
                            @foreach (Model.PersonalAlmacen asis in ViewBag.asistentes)
                            {
                                <option @(item.asistente.idPersonalAlmacen.Equals(asis.idPersonalAlmacen) ? "selected" : "") value="@asis.idPersonalAlmacen">@asis.ToString()</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="form-group">
                    <label class="control-label col-xs-2">Observaciones:</label>
                    <div class="col-xs-10">
                        <textarea id="consolidado_observaciones" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="grid-selector-container">
                    <div class="grid-selector-toolbar">
                        <h2 class="grid-selector-title" id="gs-title">Búsqueda de Clientes</h2>
                        <button class="grid-selector-btn" id="gs-toggle-btn" type="button">Ver Seleccionados (0)</button>
                    </div>

                    <div id="gs-wrapper" class="grid-selector-wrapper">
                        <div class="grid-selector-header-cell gs-col-check"></div>
                        <div class="grid-selector-header-cell">Nro.</div>
                        <div class="grid-selector-header-cell">Cliente</div>
                        <div class="grid-selector-header-cell">Fecha Entrega</div>
                        <div class="grid-selector-header-cell">Estado Stock</div>
                        <div class="grid-selector-header-cell">Observaciones</div>

                        <div id="gs-body" style="display: contents;"></div>
                    </div>
                </div>
            </div>
        </div>

        <br />
        <div class="row">
            <div class="pull-right">
                <button type="button" id="btnCancelarConsolidado" class="btn btn-danger">Cancelar</button>
                <button id="btnFinalizarEdicionConsolidado" type="button" class="btn btn-success">Finalizar @(item.idConsolidadoAtencion.Equals(Guid.Empty) ? "Creación" : "Edición")</button>
            </div>
        </div>

    </form>
</div>


<style>
    /* Variables de configuración del componente */
    :root {
        --gs-primary: #2563eb;
        --gs-bg-header: #f8fafc;
        --gs-border: #e2e8f0;
        --gs-text-dark: #1e293b;
        --gs-text-muted: #64748b;
        --gs-radius: 8px;
    }

    .grid-selector-container {
        border: 1px solid var(--gs-border);
        border-radius: var(--gs-radius);
        background: #fff;
        font-family: 'Segoe UI', Roboto, sans-serif;
        overflow: hidden;
        color: var(--gs-text-dark);
    }

    /* Toolbar */
    .grid-selector-toolbar {
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
        border-bottom: 1px solid var(--gs-border);
    }

    .grid-selector-title {
        margin: 0;
        font-size: 2rem;
        font-weight: 600;
    }

    .grid-selector-btn {
        background: var(--gs-primary);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
        transition: background 0.2s;
    }

    .grid-selector-btn:hover {
        opacity: 0.9;
    }

    /* Estructura de Tabla con Grid */
    .grid-selector-wrapper {
        display: grid;
        /* Definición base: Check | Nro | Cliente | Fecha | Estado | Obs */
        grid-template-columns: 40px 12% 30% 12% 17% 22%;
        width: 100%;
    }

    /* Cuando se oculta el checkbox */
    .grid-selector-wrapper.no-check {
        grid-template-columns: 12% 30% 12% 17% 22%;
    }

    .grid-selector-header-cell {
        background: var(--gs-bg-header);
        padding: 12px;
        font-size: 1.3rem;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--gs-text-muted);
        border-bottom: 2px solid var(--gs-border);
    }

    .grid-selector-cell {
        padding: 12px;
        border-bottom: 1px solid var(--gs-border);
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .grid-selector-row:hover .grid-selector-cell {
        background-color: #f1f5f9;
    }

    /* Checkbox */
    .grid-selector-check-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: var(--gs-primary);
    }

    /* Badge de Estado */
    .grid-selector-badge {
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 600;
        background: #e2e8f0;
    }

    .grid-selector-badge-active {
        background: #dcfce7;
        color: #166534;
    }

    .grid-selector-badge-partial {
        background: #f1cf2d;
        color: #876800;
    }

    .grid-selector-hidden {
        display: none !important;
    }
</style>



@section Scripts {
    @Scripts.RenderFormat("<script type=\"text/javascript\" src=\"{0}?nocache=" + TempData["ScriptVersion"] + "\"></script>", "~/bundles/consolidadoAtencion")
}