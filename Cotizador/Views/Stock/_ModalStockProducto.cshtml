
<div class="modal fade" tabindex="-1" id="modalStockProductoSedes">
    <div class="modal-dialog">

        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="modalStockProductoSedesTitle"><b>Stock de producto por Sede al @DateTime.Now.ToString("dd/MM/yyyy")</b></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <p></p>
            </div>

            <div class="modal-body">
                <div class="row" id="divSelEmpresaStockProductoSedes">
                    <div class="col-sm-12 col-lg-12">
                        <div class="form-group">
                            <label class="control-label col-xs-2">Ver Stock de:</label>
                            <div class="col-xs-10">
                                <select id="selectEmpresaStockProductoSedes" class="form-control" style="margin-top: -5px;">
                                </select>
                                <br />
                                <br />
                            </div>
                        </div>
                    </div>
                    
                </div>
                <div class="row">
                    <div class="col-sm-6 col-lg-8">
                        <div class="form-group">
                            <label class="control-label col-xs-2">Producto:</label>
                            <div class="col-xs-10">
                                <span class="form-control-static" id="verNombreProductoStock"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-4">
                        <div class="form-group">
                            <label class="control-label col-xs-4">Código:</label>
                            <div class="col-xs-8">
                                <span class="form-control-static" id="verCodigoProductoStock"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-8">
                        <div class="form-group">
                            <label class="control-label col-xs-2">Unidad:</label>
                            <div class="col-xs-8">
                                <select id="selectUnidadProductoStock" class="form-control">
                                </select>

                                @*<span class="form-control-static" id="verUnidadProductoStock"></span>*@
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-4 col-lg-4">
                        <div class="form-group">
                            <label for="numero" class="control-label col-xs-4"><span id="verNombreSedeProductoStock"></span>:</label>

                            <div class="col-xs-8">
                                <span class="form-control-static text-center stock-sede" id="verStockSedeProducto"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row" id="divStockProductoOtrasSedes">
                </div>
                <br />
                <div class="row">
                    <div class="col-sm-4 col-lg-4">
                        <div class="form-group">
                            <label class="control-label col-xs-4">TOTAL:</label>

                            <div class="col-xs-8">
                                <span class="form-control-static text-center stock-sede" id="verStockTodasSedes"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <br />
                <div class="row">
                    <div class="col-sm-12 col-lg-12">
                        <p><b>*</b> El número que esta entre llaves "{}" es el stock disponible que resta del stock fisico el stock reservado a clientes.</p>
                        <p><b>*</b> El número que esta en el cuadro verde en positivo "+" debajo del stock de cada sede indica la cantidad del producto por recibir en la sede (En pedidos que tienen plazo de entrega activo, o que su plazo de recepción comenzará dentro de los próximos <span class="spnRSPDiasPendientePost">14</span> días, o cuyo plazo de recepción se venció hace <span class="spnRSPDiasPendienteAnt">7</span> días o menos.</p>
                        <p><b>*</b> El número que esta en el cuadro rojo en negativo "-" debajo del stock de cada sede indica la cantidad del producto por atender en la sede (En pedidos que tienen plazo de entrega activo, o que su plazo de entrega comenzará dentro de los próximos <span class="spnRSPDiasPendientePost">14</span> días, o cuyo plazo de entrega se venció hace <span class="spnRSPDiasPendienteAnt">7</span> días o menos.</p>
                    </div>
                </div>
                <br />
                <div class="row" id="divCiudadModalStockSedeProducto">
                    <div class="col-sm-12 col-lg-12">
                        <h4>
                            Ver Kardex en la sede:
                            @Html.Action("GetCiudades", "Ciudad",
                            new
                            {
                             ciudadSelectId = "idCiudadModalStockSedeProducto"
                            })
                            <button type="button" class="btn btn-primary verModalStockProductoKardex">Ver Kardex</button>
                        </h4>
                    </div>
                </div>

                <br />
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">
    function funcionesModalStockProducto() {

        var idCiudad = '';
        var idProducto = '';
        var sku = '';
        var idProductoPresentacion = 0;
        var idEmpresa = 0;

        $(document).on('click', "button.verModalStockProducto", function () {
            idCiudad = $(this).attr("idCiudad");
            sku = $(this).attr("sku");
            idProductoPresentacion = $(this).attr("idProductoPresentacion");
            idProducto = "";

            llenarSelectorEmpresas();
        });


        function llenarCuadroStock() {
             $('body').loadingModal({
                 text: 'Recuperando Stock...'
             });
             $('body').loadingModal('show');


             $.ajax({
                 url: "/Stock/ReporteStockProducto",
                 type: 'POST',
                 dataType: 'JSON',
                 data: {
                     idCiudad: idCiudad,
                     sku: sku,
                     idEmpresaUI: idEmpresa
                 },
                 error: function (detalle) {
                     $('body').loadingModal('hide');
                 },
                 success: function (result) {
                     $(".spnRSPDiasPendientePost").html(result.diasPost);
                     $(".spnRSPDiasPendienteAnt").html(result.diasAnt);
                     var lista = result.lista;

                     var htmlStockSedes = "";
                     var htmlOptionsUnidad = "";
                     var stock, stockSeparado, stockEsperado, stockDisponible;
                     var stockTotal, stockTotalSeparado, stockTotalEsperado, stockTotalDispoible;
                     var stockTotalMP, stockTotalSeparadoMP, stockTotalEsperadoMP, stockTotalDispoibleMP;
                     var stockTotalAlternativa, stockTotalSeparadoAlternativa, stockTotalEsperadoAlternativa, stockTotalDispoibleAlternativa;
                     var stockTotalProveedor, stockTotalSeparadoProveedor, stockTotalEsperadoProveedor, stockTotalDispoibleProveedor;
                     var stockTotalConteo, stockTotalSeparadoConteo, stockTotalEsperadoConteo, stockTotalDispoibleConteo;
                     var disponible = false;
                     var unidadSelected = "";
                     stockTotal = 0; stockTotalSeparado = 0; stockTotalEsperado = 0; stockTotalDispoible = 0;
                     stockTotalMP = 0; stockTotalSeparadoMP = 0; stockTotalEsperadoMP = 0; stockTotalDispoibleMP = 0;
                     stockTotalAlternativa = 0; stockTotalSeparadoAlternativa = 0; stockTotalEsperadoAlternativa = 0; stockTotalDispoibleAlternativa = 0;
                     stockTotalProveedor = 0; stockTotalSeparadoProveedor = 0; stockTotalEsperadoProveedor = 0; stockTotalDispoibleProveedor = 0;
                     stockTotalConteo = 0; stockTotalSeparadoConteo = 0; stockTotalEsperadoConteo = 0; stockTotalDispoibleConteo = 0;

                     var stockMP = "";
                     var stockAlternativo = "";
                     var stockProveedor = "";
                     var stockConteo = "";

                     var stockDisponibleMP = "";
                     var stockDisponibleAlternativo = "";
                     var stockDisponibleProveedor = "";
                     var stockDisponibleConteo = "";

                     for (var i = 0; i < lista.length; i++) {
                         stock = 0; stockSeparado = 0; stockEsperado = 0; stockDisponible = 0;
                         atributosStockSede = "";

                         if (lista[i].ciudad.idCiudad == idCiudad) {
                             $("#verNombreSedeProductoStock").html(lista[i].ciudad.nombre);
                             $(".verModalStockProductoKardex").attr("nombreCiudad", lista[i].ciudad.nombre);
                             idProducto = lista[i].producto.idProducto;

                             $("#verNombreProductoStock").html(lista[i].producto.descripcion);
                             $("#verCodigoProductoStock").html(lista[i].producto.sku);

                             if (lista[i].stockNoDisponible) {
                                 stock = "No Registrado";
                                 stockMP = stock;
                                 stockAlternativo = stock;
                                 stockProveedor = stock;
                                 stockConteo = stock;

                                 stockDisponibleMP = 0;
                                 stockDisponibleAlternativo = 0;
                                 stockDisponibleProveedor = 0;
                                 stockDisponibleConteo = 0;
                             } else {
                                 disponible = true;

                                 stockMP = lista[i].cantidadMpCalc;
                                 stockAlternativo = lista[i].cantidadAlternativaCalc;
                                 stockProveedor = lista[i].cantidadProveedorCalc;
                                 stockConteo = lista[i].cantidadConteo;

                                 stockDisponibleMP = stockMP - lista[i].cantidadReservadaEntregarMpCalc + lista[i].cantidadReservadaRecibirMpCalc;
                                 stockDisponibleAlternativo = stockAlternativo - lista[i].cantidadReservadaEntregarAlternativaCalc + lista[i].cantidadReservadaRecibirAlternativaCalc;
                                 stockDisponibleProveedor = stockProveedor - lista[i].cantidadReservadaEntregarProveedorCalc + lista[i].cantidadReservadaRecibirProveedorCalc;
                                 stockDisponibleConteo = stockConteo - lista[i].cantidadReservadaEntregarConteo + lista[i].cantidadReservadaRecibirConteo;

                                 if (idProductoPresentacion == '0') {
                                     stock = lista[i].cantidadMpCalc;
                                 }

                                 if (idProductoPresentacion == '1') {
                                     stock = lista[i].cantidadAlternativaCalc;
                                 }
                                 if (idProductoPresentacion == '2') {
                                     stock = lista[i].cantidadProveedorCalc;
                                 }

                                 stockTotal = stockTotal + stock;

                                 stockTotalMP = stockTotalMP + lista[i].cantidadMpCalc;
                                 stockTotalAlternativa = stockTotalAlternativa + lista[i].cantidadAlternativaCalc;
                                 stockTotalProveedor = stockTotalProveedor + lista[i].cantidadProveedorCalc;
                                 stockTotalConteo = stockTotalConteo + lista[i].cantidadConteo;
                             }

                             if (idProductoPresentacion == '0') {
                                 stockSeparado = lista[i].cantidadSeparadaMpCalc;
                                 stockEsperado = lista[i].cantidadEsperadaMpCalc;
                                 stockDisponible = stockDisponibleMP;
                             }

                             if (idProductoPresentacion == '1') {
                                 stockSeparado = lista[i].cantidadSeparadaAlternativaCalc;
                                 stockEsperado = lista[i].cantidadEsperadaAlternativaCalc;
                                 stockDisponible = stockDisponibleAlternativo;
                             }
                             if (idProductoPresentacion == '2') {
                                 stockSeparado = lista[i].cantidadSeparadaProveedorCalc;
                                 stockEsperado = lista[i].cantidadEsperadaProveedorCalc;
                                 stockDisponible = stockDisponibleProveedor;
                             }

                             stockTotalSeparado = stockTotalSeparado + stockSeparado;
                             stockTotalEsperado = stockTotalEsperado + stockEsperado;
                             stockTotalDispoible = stockTotalDispoible + stockDisponible;

                             stockTotalSeparadoMP = stockTotalSeparadoMP + lista[i].cantidadSeparadaMpCalc;
                             stockTotalEsperadoMP = stockTotalEsperadoMP + lista[i].cantidadEsperadaMpCalc;
                             stockTotalDispoibleMP = stockTotalDispoibleMP + stockDisponibleMP;
                             stockTotalSeparadoAlternativa = stockTotalSeparadoAlternativa + lista[i].cantidadSeparadaAlternativaCalc;
                             stockTotalEsperadoAlternativa = stockTotalEsperadoAlternativa + lista[i].cantidadEsperadaAlternativaCalc;
                             stockTotalDispoibleAlternativa = stockTotalDispoibleAlternativa + stockDisponibleAlternativo;
                             stockTotalSeparadoProveedor = stockTotalSeparadoProveedor + lista[i].cantidadSeparadaProveedorCalc;
                             stockTotalEsperadoProveedor = stockTotalEsperadoProveedor + lista[i].cantidadEsperadaProveedorCalc;
                             stockTotalDispoibleProveedor = stockTotalDispoibleProveedor + stockDisponibleProveedor;
                             stockTotalSeparadoConteo = stockTotalSeparadoConteo + lista[i].cantidadSeparadaConteo;
                             stockTotalEsperadoConteo = stockTotalEsperadoConteo + lista[i].cantidadEsperadaConteo;
                             stockTotalDispoibleConteo = stockTotalDispoibleConteo + stockDisponibleConteo;

                             if (stock != "No Registrado") {
                                 stock = stock + ' {' + stockDisponible + '}';
                                 stockMP = stockMP + ' {' + stockDisponibleMP + '}';
                                 stockAlternativo = stockAlternativo + ' {' + stockDisponibleAlternativo + '}';
                                 stockProveedor = stockProveedor + ' {' + stockDisponibleProveedor + '}';
                                 stockConteo = stockConteo + ' {' + stockDisponibleConteo + '}';
                             }
                             

                             if (stockEsperado > 0) {
                                 stock = stock + ' [+' + stockEsperado + ']';
                                 stockMP = stockMP + ' [+' + lista[i].cantidadEsperadaMpCalc + ']';
                                 stockAlternativo = stockAlternativo + ' [+' + lista[i].cantidadEsperadaAlternativaCalc + ']';
                                 stockProveedor = stockProveedor + ' [+' + lista[i].cantidadEsperadaProveedorCalc + ']';
                                 stockConteo = stockConteo + ' [+' + lista[i].cantidadEsperadaConteo + ']';
                             }

                             if (stockSeparado > 0) {
                                 stock = stock + ' [-' + stockSeparado + ']';
                                 stockMP = stockMP + ' [-' + lista[i].cantidadSeparadaMpCalc + ']';
                                 stockAlternativo = stockAlternativo + ' [-' + lista[i].cantidadSeparadaAlternativaCalc + ']';
                                 stockProveedor = stockProveedor + ' [-' + lista[i].cantidadSeparadaProveedorCalc + ']';
                                 stockConteo = stockConteo + ' [-' + lista[i].cantidadSeparadaConteo + ']';
                             }

                             stock = armarHtmlLinkPendienteAtencion(stock + '', lista[i].producto.idProducto, idProductoPresentacion, lista[i].ciudad.idCiudad, '', '');


                             unidadSelected = "";
                             if (idProductoPresentacion == '1') {
                                 //$("#verUnidadProductoStock").html(lista[i].producto.unidad_alternativa);
                                 unidadSelected = "selected";
                             }

                             if (lista[i].producto.equivalenciaAlternativa > 1) {
                                 htmlOptionsUnidad = htmlOptionsUnidad + '<option value="1" ' + unidadSelected + '>' + lista[i].producto.unidad_alternativa + '</option>';
                             }

                             unidadSelected = "";
                             if (idProductoPresentacion == '0') {
                                 //$("#verUnidadProductoStock").html(lista[i].producto.unidad);
                                 unidadSelected = "selected";
                             }

                             htmlOptionsUnidad = htmlOptionsUnidad + '<option value="0" ' + unidadSelected + '>' + lista[i].producto.unidad + '</option>';


                             unidadSelected = "";
                             if (idProductoPresentacion == '2') {
                                 //$("#verUnidadProductoStock").html(lista[i].producto.unidadProveedor);
                                 unidadSelected = "selected";
                             }

                             if (lista[i].producto.equivalenciaProveedor > 1) {
                                 htmlOptionsUnidad = htmlOptionsUnidad + '<option value="2" ' + unidadSelected + '>' + lista[i].producto.unidadProveedor + '</option>';
                             }

                             $("#verStockSedeProducto").html(stock);
                             $("#verStockSedeProducto").attr("idCiudad", lista[i].ciudad.idCiudad);
                             $("#verStockSedeProducto").attr("idProducto", idProducto);
                             $("#verStockSedeProducto").attr("mp", stockMP);
                             $("#verStockSedeProducto").attr("alternativa", stockAlternativo);
                             $("#verStockSedeProducto").attr("proveedor", stockProveedor);
                             $("#verStockSedeProducto").attr("conteo", stockConteo);

                         } else {
                             if (lista[i].stockNoDisponible) {
                                 stock = "No Registrado";
                                 stockMP = stock;
                                 stockAlternativo = stock;
                                 stockProveedor = stock;
                                 stockConteo = stock;
                             } else {
                                 disponible = true;

                                 stockMP = lista[i].cantidadMpCalc;
                                 stockAlternativo = lista[i].cantidadAlternativaCalc;
                                 stockProveedor = lista[i].cantidadProveedorCalc;
                                 stockConteo = lista[i].cantidadConteo;

                                 stockDisponibleMP = stockMP - lista[i].cantidadReservadaEntregarMpCalc + lista[i].cantidadReservadaRecibirMpCalc;
                                 stockDisponibleAlternativo = stockAlternativo - lista[i].cantidadReservadaEntregarAlternativaCalc + lista[i].cantidadReservadaRecibirAlternativaCalc;
                                 stockDisponibleProveedor = stockProveedor - lista[i].cantidadReservadaEntregarProveedorCalc + lista[i].cantidadReservadaRecibirProveedorCalc;
                                 stockDisponibleConteo = stockConteo - lista[i].cantidadReservadaEntregarConteo + lista[i].cantidadReservadaRecibirConteo;

                                 if (idProductoPresentacion == '0') {
                                     stock = lista[i].cantidadMpCalc;
                                 }

                                 if (idProductoPresentacion == '1') {
                                     stock = lista[i].cantidadAlternativaCalc;
                                 }
                                 if (idProductoPresentacion == '2') {
                                     stock = lista[i].cantidadProveedorCalc;
                                 }

                                 stockTotal = stockTotal + stock;

                                 stockTotalMP = stockTotalMP + lista[i].cantidadMpCalc;
                                 stockTotalAlternativa = stockTotalAlternativa + lista[i].cantidadAlternativaCalc;
                                 stockTotalProveedor = stockTotalProveedor + lista[i].cantidadProveedorCalc;
                                 stockTotalConteo = stockTotalConteo + lista[i].cantidadConteo;
                             }
                             

                             if (idProductoPresentacion == '0') {
                                 stockSeparado = lista[i].cantidadSeparadaMpCalc;
                                 stockEsperado = lista[i].cantidadEsperadaMpCalc;
                                 stockDisponible = stockDisponibleMP;
                             }

                             if (idProductoPresentacion == '1') {
                                 stockSeparado = lista[i].cantidadSeparadaAlternativaCalc;
                                 stockEsperado = lista[i].cantidadEsperadaAlternativaCalc;
                                 stockDisponible = stockDisponibleAlternativo;
                             }
                             if (idProductoPresentacion == '2') {
                                 stockSeparado = lista[i].cantidadSeparadaProveedorCalc;
                                 stockEsperado = lista[i].cantidadEsperadaProveedorCalc;
                                 stockDisponible = stockDisponibleProveedor;
                             }

                             stockTotalSeparado = stockTotalSeparado + stockSeparado;
                             stockTotalEsperado = stockTotalEsperado + stockEsperado;

                             stockTotalSeparadoMP = stockTotalSeparadoMP + lista[i].cantidadSeparadaMpCalc;
                             stockTotalEsperadoMP = stockTotalEsperadoMP + lista[i].cantidadEsperadaMpCalc;
                             stockTotalDispoibleMP = stockTotalDispoibleMP + stockDisponibleMP;
                             stockTotalSeparadoAlternativa = stockTotalSeparadoAlternativa + lista[i].cantidadSeparadaAlternativaCalc;
                             stockTotalEsperadoAlternativa = stockTotalEsperadoAlternativa + lista[i].cantidadEsperadaAlternativaCalc;
                             stockTotalDispoibleAlternativa = stockTotalDispoibleAlternativa + stockDisponibleAlternativo;
                             stockTotalSeparadoProveedor = stockTotalSeparadoProveedor + lista[i].cantidadSeparadaProveedorCalc;
                             stockTotalEsperadoProveedor = stockTotalEsperadoProveedor + lista[i].cantidadEsperadaProveedorCalc;
                             stockTotalDispoibleProveedor = stockTotalDispoibleProveedor + stockDisponibleProveedor;
                             stockTotalSeparadoConteo = stockTotalSeparadoConteo + lista[i].cantidadSeparadaConteo;
                             stockTotalEsperadoConteo = stockTotalEsperadoConteo + lista[i].cantidadEsperadaConteo;
                             stockTotalDispoibleConteo = stockTotalDispoibleConteo + stockDisponibleConteo;

                             if (stock != "No Registrado") {
                                 stock = stock + ' {' + stockDisponible + '}';
                                 stockMP = stockMP + ' {' + stockDisponibleMP + '}';
                                 stockAlternativo = stockAlternativo + ' {' + stockDisponibleAlternativo + '}';
                                 stockProveedor = stockProveedor + ' {' + stockDisponibleProveedor + '}';
                                 stockConteo = stockConteo + ' {' + stockDisponibleConteo + '}';
                             }

                             if (stockEsperado > 0) {
                                 stock = stock + ' [+' + stockEsperado + ']';
                                 stockMP = stockMP + ' [+' + lista[i].cantidadEsperadaMpCalc + ']';
                                 stockAlternativo = stockAlternativo + ' [+' + lista[i].cantidadEsperadaAlternativaCalc + ']';
                                 stockProveedor = stockProveedor + ' [+' + lista[i].cantidadEsperadaProveedorCalc + ']';
                                 stockConteo = stockConteo + ' [+' + lista[i].cantidadEsperadaConteo + ']';
                             }

                             if (stockSeparado > 0) {
                                 stock = stock + ' [-' + stockSeparado + ']';
                                 stockMP = stockMP + ' [-' + lista[i].cantidadSeparadaMpCalc + ']';
                                 stockAlternativo = stockAlternativo + ' [-' + lista[i].cantidadSeparadaAlternativaCalc + ']';
                                 stockProveedor = stockProveedor + ' [-' + lista[i].cantidadSeparadaProveedorCalc + ']';
                                 stockConteo = stockConteo + ' [-' + lista[i].cantidadSeparadaConteo + ']';
                             }

                             stock = armarHtmlLinkPendienteAtencion(stock + '', lista[i].producto.idProducto, idProductoPresentacion, lista[i].ciudad.idCiudad, '', '');

                             atributosStockSede = ' mp="' + stockMP + '" alternativa="' + stockAlternativo + '" proveedor="' + stockProveedor + '" conteo="' + stockConteo + '" ';

                             htmlStockSedes = htmlStockSedes + '<div class="col-sm-4 col-lg-4" style="height: 40px;"><div class="form-group"><label class="control-label col-xs-4">' +
                                 lista[i].ciudad.nombre + ':</label><div class="col-xs-8"><span class="stock-sede form-control-static" idCiudad="'
                                 + lista[i].ciudad.idCiudad + '" idProducto="' + lista[i].producto.idProducto + '" '
                                 + atributosStockSede + '>' + stock + '</span></div></div></div>';
                         }
                     }

                     if (disponible) {
                         $("#divCiudadModalStockSedeProducto").show();
                         var stockTotalText = stockTotal.toFixed(2) + " [+" + stockTotalEsperado.toFixed(2) + "]" + " [-" + stockTotalSeparado.toFixed(2) + "]";
                         stockTotalText = armarHtmlLinkPendienteAtencion(stockTotalText, idProducto, idProductoPresentacion, "@Guid.Empty", '', '');

                         $("#verStockTodasSedes").html(stockTotalText);
                         $("#verStockTodasSedes").attr("idProducto", idProducto);
                         $("#verStockTodasSedes").attr("idCiudad", "@Guid.Empty");
                         $("#verStockTodasSedes").attr("mp", stockTotalMP.toFixed(2) + ' [+' + stockTotalEsperadoMP.toFixed(2) + ']' + ' [-' + stockTotalSeparadoMP.toFixed(2) + ']');
                         $("#verStockTodasSedes").attr("alternativa", stockTotalAlternativa.toFixed(2) + ' [+' + stockTotalEsperadoAlternativa.toFixed(2) + ']' + ' [-' + stockTotalSeparadoAlternativa.toFixed(2) + ']');
                         $("#verStockTodasSedes").attr("proveedor", stockTotalProveedor.toFixed(2) + ' [+' + stockTotalEsperadoProveedor.toFixed(2) + ']' + ' [-' + stockTotalSeparadoProveedor.toFixed(2) + ']');
                         $("#verStockTodasSedes").attr("conteo", stockTotalConteo.toFixed(2) + ' [+' + stockTotalEsperadoConteo.toFixed(2) + ']' + ' [-' + stockTotalSeparadoConteo.toFixed(2) + ']');
                     } else {
                         $("#divCiudadModalStockSedeProducto").hide();
                         $("#verStockTodasSedes").html("No Registrado");
                         $("#verStockTodasSedes").attr("idProducto", idProducto);
                         $("#verStockTodasSedes").attr("idCiudad", "@Guid.Empty");
                         $("#verStockTodasSedes").attr("mp", "No Registrado");
                         $("#verStockTodasSedes").attr("alternativa", "No Registrado");
                         $("#verStockTodasSedes").attr("proveedor", "No Registrado");
                         $("#verStockTodasSedes").attr("conteo", "No Registrado");
                     }

                     $(".verModalStockProductoKardex").attr("idCiudad", idCiudad);
                     $(".verModalStockProductoKardex").attr("idProducto", idProducto);
                     $(".verModalStockProductoKardex").attr("idProductoPresentacion", idProductoPresentacion);

                     $("#idCiudadModalStockSedeProducto").val(idCiudad);



                     $("#divStockProductoOtrasSedes").html(htmlStockSedes);

                     $("#selectUnidadProductoStock").html(htmlOptionsUnidad);

                     $('body').loadingModal('hide');

                     $("#modalStockProductoSedes").modal();
                 }
             });
        };

        function armarHtmlLinkPendienteAtencion(stockText, idProducto, idProductoPresentacion, idCiudad, fechaInicio, fechaFin) {
            const dataAttrs = `idProducto="${idProducto}" idProductoPresentacion="${idProductoPresentacion}" idCiudad="${idCiudad}" fechaInicio="${fechaInicio}" fechaFin="${fechaFin}"`;

            stockText = stockText.replace(/\[/, "<br/>[");

            const linkAtencion = `<a class="verModalStockPendienteAtencion" ${dataAttrs}><span class="label label-stock-less">-`;
            stockText = stockText.replace("[-", linkAtencion);

            const linkRecepcion = `<a class="verModalStockPendienteRecepcion" ${dataAttrs}><span class="label label-stock-plus">+`;
            stockText = stockText.replace("[+", linkRecepcion);

            return stockText.replace(/\]/g, "</span></a>");
        }

        function llenarSelectorEmpresas() {
            idEmpresa = 0;

            $('body').loadingModal({
                text: 'Cargando...'
            });
            $('body').loadingModal('show');

            $.ajax({
                url: "/Stock/ReporteStockEmpresasVer",
                type: 'POST',
                dataType: 'JSON',
                data: {
                },
                error: function (detalle) {
                    $('body').loadingModal('hide');
                    alert("ERROR, intente recargar el formulario.");
                },
                success: function (result) {
                    var idSelected = result.idEmpresaDefecto;
                    lista = result.lista;

                    var htmlOptionsEmpresa = "";
                    var empresaSelected = "";

                    for (var i = 0; i < lista.length; i++) {
                        empresaSelected = "";
                        if (idSelected == lista[i].idEmpresa) {
                            empresaSelected = "selected";
                            idEmpresa = idSelected;
                        }

                        htmlOptionsEmpresa = htmlOptionsEmpresa + '<option value="' + lista[i].idEmpresa + '" ' + empresaSelected + '>' + lista[i].nombre + '</option>';
                    }

                    $("#selectEmpresaStockProductoSedes").html(htmlOptionsEmpresa);

                    if (lista.length > 1) {
                        $("#divSelEmpresaStockProductoSedes").show();
                    } else {
                        $("#divSelEmpresaStockProductoSedes").hide();
                    }

                    
                    llenarCuadroStock();
                }
            });
        };

        $(document).on('change', "#idCiudadModalStockSedeProducto", function () {
            $(".verModalStockProductoKardex").attr("idCiudad", $(this).val());
            $(".verModalStockProductoKardex").attr("nombreCiudad", $(this).closest("option:selected").text());
        });

        $(document).on('change', "#selectUnidadProductoStock", function () {
            var idPresentacion = $(this).val();
            $(".stock-sede").each(function () {
                var stockText = "";
                if (idPresentacion == 0) {
                    stockText = $(this).attr("mp");
                }

                if (idPresentacion == 1) {
                    stockText = $(this).attr("alternativa");
                }

                if (idPresentacion == 2) {
                    stockText = $(this).attr("proveedor");
                }

                if (idPresentacion == 3) {
                    stockText = $(this).attr("conteo");
                }

                stockText = armarHtmlLinkPendienteAtencion(stockText, $(this).attr("idProducto"), idPresentacion, $(this).attr("idCiudad"), '', '');
                $(this).html(stockText);
            });
        });

        $(document).on('change', "#selectEmpresaStockProductoSedes", function () {
            idEmpresa = $(this).val();
            llenarCuadroStock();
        });
    };

    if (window.addEventListener) // W3C standard
    {
        window.addEventListener('load', funcionesModalStockProducto, false);
    }
    else if (window.attachEvent) // Microsoft
    {
        window.attachEvent('onload', funcionesModalStockProducto);
    }

</script>



@Html.Partial("../Stock/_ModalKardexStockProducto")