@{
    ViewBag.Title = "Control Stock";

    Model.ProductoControlStock search = new Model.ProductoControlStock();
    Cotizador.Models.OBJsFiltro.ControlStockFiltro filtro = ViewBag.filtro;

    List<Model.ProductoControlStock> lista = ViewBag.lista;
    string formatoDosDecimales = "{0:0.00}";

    string idsControl = string.Join(";", lista.Select(x => x.idProductoControlStock));

}

<div class="page-header">
    <h3>@ViewBag.Title</h3>
</div>
<div class="container">
    <input type="hidden" id="pagina" value="@ViewBag.pagina" />
    <input type="hidden" id="idsControlResultados" value="@idsControl" />

    <form class="form-horizontal">

        <div class="row" style="margin-top: 10px;">
            <div class="col-sm-6 col-lg-4">
                <div class="form-group row">
                    <label class="control-label col-xs-4" for="idCiudad">
                        Sede:
                    </label>
                    <div class="col-xs-8">
                        @Html.Action("GetCiudades", "Ciudad",
                                    new
                                    {
                                        ciudadSelectId = "idCiudad",
                                        selectedValue = filtro.idCiudad
                                    })
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="form-group row">
                    <button id="btnAculizarControlCiudad" type="button" class="btn btn-warning">Actualizar Stocks Sede</button>
                </div>
            </div>
            <div class="col-sm-6 col-lg-4">
                <div class="form-group row">
                    <label class="control-label col-xs-4" for="tipoUnidad">Unidad:</label>
                    <div class="col-xs-8">
                        <select class="form-control" id="tipoUnidad" name="tipoUnidad">
                            <option @(filtro.idPresentacionUnidad == 0 ? "selected" : "") value="0">MP</option>
                            <option @(filtro.idPresentacionUnidad == 1 ? "selected" : "") value="1">Alternativa</option>
                            <option @(filtro.idPresentacionUnidad == 2 ? "selected" : "") value="2">Proveedor</option>
                            <option @(filtro.idPresentacionUnidad == 3 ? "selected" : "") value="3">Conteo</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" style="margin-top: 10px;">
            <div class="col-sm-6 col-lg-4">
                <div class="form-group">
                    <label class="control-label col-xs-4" for="skuProducto">SKU:</label>
                    <div class="col-xs-8">
                        <input class="form-control" type="text" id="skuProducto" name="skuProducto" value="@filtro.sku">
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <!--Proveedor-->
                <div class="form-group">
                    <label class="control-label col-xs-4" for="proveedor">Proveedor:</label>
                    <div class="col-xs-8">
                        <div>
                            @Html.Action("list", "Proveedor")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="form-group">
                    <label class="control-label col-xs-4" for="familia">Estado Stock Viurtal:</label>
                    <div class="col-xs-8">
                        <!--Checks de estados de stock-->
                        <label class="checkbox-inline">
                            <span class="label label-success" style="padding: 5px 10px;">
                                <input type="checkbox" id="filtroStockVerde" @(filtro.stockVerde ? "checked" : "")> Cubierto
                            </span>
                        </label>
                        <br />
                        <label class="checkbox-inline">
                            <span class="label label-warning" style="padding: 5px 10px;">
                                <input type="checkbox" id="filtroStockAmbar" @(filtro.stockAmbar ? "checked" : "")> Alerta
                            </span>
                        </label>
                        <br />
                        <label class="checkbox-inline">
                            <span class="label label-danger" style="padding: 5px 10px;">
                                <input type="checkbox" id="filtroStockRojo" @(filtro.stockRojo ? "checked" : "")> Crítico
                            </span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">

        </div>

        <div class="row pull-right" style="margin-bottom:10px; margin-right:0px">
            <button id="btnLimpiarBusqueda" type="button" class="btn btn-primary  bouton-image botonClean">Limpiar</button>
            <button id="btnBusqueda" type="button" class="btn btn-primary  bouton-image botonSearch">Buscar</button>
            <br /><br />
            <button id="btnAculizarControlResultados" type="button" class="btn btn-warning right">Actualizar Stocks</button>
        </div>

        <div id="divExportButton" class="row pull-left" style="margin-bottom:10px; margin-left:0px; display: none;">
            <button id="btnAgregarFabricante" type="button" class="btn btn-primary">Registrar Nuevo Fabricante</button>
            <button id="btnExportExcel" type="button" class="btn btn-primary  bouton-image botonExcel">Exportar</button>
        </div>

        <table id="tableControlStock" class="table" data-editing="false" data-paging="true" data-paging-count-format="{CP} de {TP}"
               data-editing-allow-add="false"
               data-editing-allow-delete="false"
               data-editing-allow-edit="false"
               data-sorting="true"
               data-show-toggle="false"
               data-editing-hide-text="Finalizar edición"
               data-editing-add-text="Descartar cambios">
            <thead>
                <tr>
                    <th data-name="sku" data-visible="true">SKU</th>
                    <th data-name="producto" data-visible="true" data-sortable="true">Producto</th>
                    <th data-name="cantidadMinima" data-visible="true" data-sortable="true">Stock Minima</th>
                    <th data-name="cantidadMaxima" data-visible="true" data-sortable="true">Stock Máxima</th>
                    <th data-name="cantidadAlerta" data-visible="true" data-sortable="true">Stock Alerta</th>
                    <th data-name="fechaCalculoStock" data-visible="true" data-sortable="true">Fecha Stock</th>
                    <th data-name="unidadCalculoStock" data-visible="true" data-sortable="true">Unidad Stock</th>
                    <th data-name="cantidadCalculoStock" data-visible="true" data-sortable="true">Stock Real</th>
                    <th data-name="cantidadCalculoStockVirtual" data-visible="true" data-sortable="true">
                        Stock Virtual
                        <label class="lblInfoDescripcionLarga tooltip-label">
                            <img src="/images/icon_info_22.png">

                            <span id="spnPromocionTextMAP" class="tooltip-label-text tooltip-label-text-info tooltiptext" style="width: 350px; left: -350px;">
                                Se calcula sumando al stock físico la cantidad pendiente por recibir (cuadro verde con signo "+") y restando la cantidad que esta pendiente de atención (cuadro rojo con signo "-") en pedidos que tienen plazo de entrega activo, o que su plazo de entrega comenzará dentro de los próximos @ViewBag.diasConsiderarPedidosPost días, o cuyo plazo de entrega se venció hace @ViewBag.diasConsiderarPedidosAnt días o menos.<br>
                            </span>
                        </label>

                    </th>
                    <th data-name="opciones" data-sortable="true" data-breakpoints="xs"></th>
                </tr>
            </thead>

            <tbody>
                @foreach (Model.ProductoControlStock item in lista)
                {
                    item.idProductoPresentacion = filtro.idPresentacionUnidad;
                    <tr>
                        <td>@item.producto.sku</td>
                        <td>@item.producto.descripcion</td>
                        <td>@item.cantidadMinimaPresentacion</td>
                        <td>@item.cantidadMaximaPresentacion</td>
                        <td>@item.cantidadAlertaPresentacion</td>
                        <td>@item.FechaCsDesc</td>
                        <td>@item.unidadPresentacion</td>
                        <td>
                            @if (item.cantidadCs <= item.cantidadMinima)
                            {
                                <span class="label label-danger" style="font-size: 100%;">@String.Format(formatoDosDecimales, item.cantidadPresentacion)</span>
                            }
                            else if (item.cantidadCs <= item.cantidadAlerta)
                            {
                                <span class="label label-warning" style="font-size: 100%;">@String.Format(formatoDosDecimales, item.cantidadPresentacion)</span>
                            }
                            else
                            {
                                <span class="label label-success" style="font-size: 100%;">@String.Format(formatoDosDecimales, item.cantidadPresentacion)</span>
                            }
                        </td>
                        <td>
                            @if (item.cantidadVirtualCs <= item.cantidadMinima)
                            {
                                <span class="label label-danger" style="font-size: 100%;">@String.Format(formatoDosDecimales, item.cantidadVirtualPresentacion)</span>
                            }
                            else if (item.cantidadVirtualCs <= item.cantidadAlerta)
                            {
                                <span class="label label-warning" style="font-size: 100%;">@String.Format(formatoDosDecimales, item.cantidadVirtualPresentacion)</span>
                            }
                            else
                            {
                                <span class="label label-success" style="font-size: 100%;">@String.Format(formatoDosDecimales, item.cantidadVirtualPresentacion)</span>
                            }
                            <br />

                            <a class="verModalStockPendienteRecepcion" idproducto="@item.producto.idProducto" idproductopresentacion="@filtro.idPresentacionUnidad" idciudad="@filtro.idCiudad" fechainicio="" fechafin="">
                                <span class="label label-stock-plus">+@String.Format(formatoDosDecimales, item.cantidadRecibirPresentacion) </span>
                            </a>
                            <a class="verModalStockPendienteAtencion" idproducto="@item.producto.idProducto" idproductopresentacion="@filtro.idPresentacionUnidad" idciudad="@filtro.idCiudad" fechainicio="" fechafin="">
                                <span class="label label-stock-less" style="margin-left: 1px;">-@String.Format(formatoDosDecimales, item.cantidadAtenderPresentacion) </span>
                            </a>
                        </td>
                        <td>
                            <button type="button" title="Consultar Stock" class="verModalStockProducto btn" sku="@item.producto.sku" idProductoPresentacion="@filtro.idPresentacionUnidad"
                                    idCiudad="@filtro.idCiudad" style="margin-top: 7px;">
                                <img src="/images/icon_stock.png" height="25" />
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
</div>


<div class="modal fade" id="modalEditarFabricante" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="modalEditarFabricanteTitle"></h4>
            </div>

            <div class="modal-body">
                <form class="form-horizontal">
                    <input type="hidden" id="fabricante_id" />
                    <div class="row">
                        <div class="col-sm-12 col-lg-12">
                            <div class="form-group">
                                @Html.LabelFor(g => search.cantidadMaxima, htmlAttributes: new { @class = "control-label col-xs-2" })
                                <div class="col-xs-10">
                                    @Html.TextBoxFor(g => search.cantidadMaxima, htmlAttributes: new { @id = "fabricante_codigo", @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-12 col-lg-12">
                            <div class="form-group">
                                @Html.LabelFor(g => search.cantidadMaxima, htmlAttributes: new { @class = "control-label col-xs-2" })
                                <div class="col-xs-10">
                                    @Html.TextBoxFor(g => search.cantidadMaxima, htmlAttributes: new { @id = "fabricante_nombreUsual", @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" id="btnCancelarFabricante" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" id="btnFinalizarEdicionFabricante" class="btn btn-primary"></button>
            </div>
        </div>
    </div>
</div>



@Html.Partial("../Stock/_ModalStockProducto")

@Html.Partial("../Stock/_ModalStockPendienteAtencion")

@Html.Partial("../Stock/_ModalStockPendienteRecepcion")

@Html.Partial("../Pedido/_ModalPedidoReadOnly")


@section Scripts {
    @Scripts.RenderFormat("<script type=\"text/javascript\" src=\"{0}?nocache=" + TempData["ScriptVersion"] + "\"></script>", "~/bundles/productoControlStock")
}
