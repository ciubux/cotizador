@{

    Model.Empresa empresa = ViewBag.empresa;
    ViewBag.Title = "Configuración Empresa para " + empresa.razonSocial;
}

<div class="page-header">
    <h3>@ViewBag.Title</h3>
</div>
<div class="container">
    <input type="hidden" id="pagina" value="@ViewBag.pagina" />

    @if (ViewBag.parametrosEditados)
    {
        <div class="alert alert-success" role="alert" style="color: #000000;">
            Se actualizaron los parámetros correctamente.
        </div>
    }

    <form class="form-horizontal" action="/Empresa/GuardarParametros" method="post">

        <div class="row">
            <div class="col-sm-12 col-lg-12">
                <div class="form-group">
                    @Html.LabelFor(dv => empresa.factorCosto, htmlAttributes: new { @class = "control-label col-xs-6 col-lg-3" })
                    <div class="col-xs-6 col-lg-3">
                        @Html.TextBoxFor(c => empresa.factorCosto, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="col-sm-12 col-lg-12">
                <div class="form-group">
                    @Html.LabelFor(dv => empresa.porcentajeMargenMinimo, htmlAttributes: new { @class = "control-label col-xs-6 col-lg-3" })
                    <div class="col-xs-6 col-lg-3">
                        @Html.TextBoxFor(c => empresa.porcentajeMargenMinimo, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="col-sm-12 col-lg-12">
                <div class="form-group">
                    @Html.LabelFor(dv => empresa.porcentajeDescuentoInframargen, htmlAttributes: new { @class = "control-label col-xs-6 col-lg-3" })
                    <div class="col-xs-6 col-lg-3">
                        @Html.TextBoxFor(c => empresa.porcentajeDescuentoInframargen, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="col-sm-12 col-lg-12">
                <div class="form-group">
                    @Html.LabelFor(dv => empresa.porcentajeMDGanaciaMax, htmlAttributes: new { @class = "control-label col-xs-6 col-lg-3" })
                    <div class="col-xs-6 col-lg-3">
                        @Html.TextBoxFor(c => empresa.porcentajeMDGanaciaMax, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="row pull-left" style="margin-bottom:10px; margin-left:0px; ">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <button onclick="location.reload();" type="button" class="btn btn-danger">Cancelar</button>
        </div>
    </form>
</div>


