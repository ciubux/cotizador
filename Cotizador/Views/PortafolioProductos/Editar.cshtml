@model Model.PortafolioProductos
@{
    var obj = (Model.PortafolioProductos)ViewBag.portafolio;
    bool esNuevo = (obj.idPortafolioProductos == Guid.Empty);
    ViewBag.Title = esNuevo ? "Registrar Portafolio de Productos" : "Editar Portafolio de Productos";
}

<div class="page-header">
    <h3><b>@ViewBag.Title</b></h3>
</div>

<div class="container-fluid" style="background: #fff; padding: 20px; border-radius: 5px;" id="contenedorEditarPortafolio">
    <input type="hidden" id="editar_idPortafolio" value="@obj.idPortafolioProductos" />

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label>Nombre:</label>
                <input type="text" class="form-control cabecera-portafolio-input" id="portafolio_nombre" data-propiedad="nombre" maxlength="200" value="@obj.nombre" placeholder="Ingrese nombre del portafolio..." />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <label>Comentarios:</label>
                <textarea class="form-control cabecera-portafolio-input" id="portafolio_comentarios" data-propiedad="comentarios" maxlength="1000" rows="3" placeholder="Ingrese comentarios...">@obj.comentarios</textarea>
            </div>
        </div>
    </div>


    <hr />

    <div class="row" style="margin-bottom: 15px;">
        <div class="col-xs-6">
            <h4 style="margin: 0; padding-top: 5px;">
                <b>Productos del Portafolio</b> <span id="badgeTotalItemsEditar" class="badge">@(obj.items != null ? obj.items.Count(x => x.Estado != 0) : 0)</span>
            </h4>
        </div>
        <div class="col-xs-6 text-right">
            <button id="btnAbrirCargaMasivaSkus" type="button" class="btn btn-info" style="margin-right: 5px;">+ Agregar Múltiples SKUs</button>
            <button id="btnAgregarItemPortafolio" type="button" class="btn btn-success">+ Agregar Producto</button>
        </div>
    </div>

    <div class="row" style="font-weight: bold; padding: 10px 0; border-bottom: 2px solid #ddd; background-color: #f9f9f9;">
        <div class="col-xs-3">SKU</div>
        <div class="col-xs-8">Descripción</div>
        <div class="col-xs-1 text-center">Acción</div>
    </div>

    <div id="contenedorItemsPortafolio">
        @if (obj.items != null)
        {
            foreach (var item in obj.items.Where(x => x.Estado != 0))
            {
                <div class="row item-row" style="padding: 10px 0; border-bottom: 1px solid #eee; display: flex; align-items: center;" data-idproducto="@item.producto.idProducto">
                    <div class="col-xs-3"><b>@item.producto.sku</b></div>
                    <div class="col-xs-8">@item.producto.descripcion</div>
                    <div class="col-xs-1 text-center">
                        <button type="button" class="btn btn-danger btn-sm btnEliminarItemPortafolio" data-idproducto="@item.producto.idProducto" title="Quitar Producto">
                            <i class="glyphicon glyphicon-trash"></i>
                        </button>
                    </div>
                </div>
            }
        }
    </div>

    <hr />

    <div class="row" style="margin-top: 20px;">
        <div class="col-xs-6 text-left">
            <button id="btnVolverListado" type="button" class="btn btn-default">Volver al Listado</button>
        </div>
        <div class="col-xs-6 text-right">
            <button id="btnGuardarAvancePortafolio" type="button" class="btn btn-warning">Guardar Avance</button>
            <button id="btnFinalizarPortafolio" type="button" class="btn btn-primary">
                @(esNuevo ? "Finalizar Registro" : "Finalizar Edición")
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCargaMasivaSkus" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><b>Carga Múltiples SKUs</b></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <p></p>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Pegue la lista de códigos SKU (uno por línea, separados por coma o espacio):</label>
                    <textarea id="txtListaSkusMasivo" class="form-control" rows="8" placeholder="Ejemplo:&#10;SKU001&#10;SKU002&#10;SKU003"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" id="btnProcesarSkusMasivo" class="btn btn-primary">Agregar Productos</button>
            </div>
        </div>
    </div>
</div>

<style>
    #contenedorItemsPortafolio .chosen-container {
        width: 100% !important;
    }
</style>

@section Scripts {
    @Scripts.RenderFormat("<script type=\"text/javascript\" src=\"{0}?nocache=" + TempData["ScriptVersion"] + "\"></script>", "~/bundles/portafolioProductos")
}