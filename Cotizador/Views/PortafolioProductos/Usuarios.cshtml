@model Model.PortafolioProductos
@{
    var obj = (Model.PortafolioProductos)ViewBag.portafolio;
    ViewBag.Title = "Usuarios del Portafolio";
}

<div class="page-header">
    <h3><b>Gestionar Usuarios - @obj.nombre</b></h3>
</div>

<div class="container-fluid" style="background: #fff; padding: 20px; border-radius: 5px;" id="contenedorUsuariosPortafolio">
    <input type="hidden" id="usuarios_idPortafolio" value="@obj.idPortafolioProductos" />

    <form class="form-horizontal" onsubmit="return false;">
        <div class="row">
            <div class="col-xs-12 col-lg-8">
                <!--Usuario-->
                <div class="form-group">
                    <label for="idUsuario" class="control-label col-xs-3">Buscar Usuario:</label>
                    <div class="col-xs-6">
                        <select class="form-control input-sm" id="idUsuario" name="idUsuario" required>
                            <option value=""></option>
                        </select>
                    </div>
                    <div class="col-xs-3">
                        <button type="button" id="btnAgregarUsuarioPortafolio" class="btn btn-success btn-sm">
                            + Agregar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <hr />

    <div class="row" style="margin-bottom: 15px;">
        <div class="col-xs-12">
            <h4 style="margin: 0;">
                <b>Usuarios Asignados</b> <span id="badgeTotalUsuariosAsignados" class="badge">@(obj.usuarios != null ? obj.usuarios.Count : 0)</span>
            </h4>
        </div>
    </div>

    <div class="row" style="font-weight: bold; padding: 10px 0; border-bottom: 2px solid #ddd; background-color: #f9f9f9;">
        <div class="col-xs-11">Usuario</div>
        <div class="col-xs-1 text-center">Acción</div>
    </div>

    <div id="contenedorListaUsuarios">
        @if (obj.usuarios != null)
        {
            foreach (var u in obj.usuarios)
            {
                <div class="row usuario-row" style="padding: 10px 0; border-bottom: 1px solid #eee; display: flex; align-items: center;" data-idusuario="@u.idUsuario">
                    <div class="col-xs-11">
                        <b>@u.nombre</b> @(!string.IsNullOrWhiteSpace(u.email) ? "(" + u.email + ")" : "")
                    </div>
                    <div class="col-xs-1 text-center">
                        <button type="button" class="btn btn-danger btn-sm btnEliminarUsuarioPortafolio" data-idusuario="@u.idUsuario" title="Quitar Usuario">
                            <i class="glyphicon glyphicon-trash"></i>
                        </button>
                    </div>
                </div>
            }
        }
    </div>

    <hr />

    <div class="row" style="margin-top: 20px;">
        <div class="col-xs-6 text-left">
            <button id="btnVolverListado" type="button" class="btn btn-default">Volver al Listado</button>
        </div>
        <div class="col-xs-6 text-right">
            <button id="btnFinalizarUsuariosPortafolio" type="button" class="btn btn-primary">Finalizar</button>
        </div>
    </div>
</div>

<style>
    #contenedorUsuariosPortafolio .chosen-container {
        width: 100% !important;
    }
</style>

@section Scripts {
    @Scripts.RenderFormat("<script type=\"text/javascript\" src=\"{0}?nocache=" + TempData["ScriptVersion"] + "\"></script>", "~/bundles/portafolioProductos")
}